---
import { profil } from '@data/profil';

const nav = [
  { href: '/referentiel', label: 'Référentiel', en: 'Framework' },
  { href: '/realisations', label: 'Réalisations', en: 'Projects' },
  { href: '/preuves', label: 'Preuves', en: 'Evidence' },
  { href: '/synthese', label: 'Synthèse', en: 'Summary' },
  { href: '/parcours', label: 'Parcours', en: 'Background' },
  { href: '/veille', label: 'Veille', en: 'Tech watch' },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => here === href || here.startsWith(href + '/');
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${profil.nom} — accueil`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <g stroke="currentColor" stroke-width="1.7" fill="none">
          <path d="M9 22 L16 10 L23 22" /><path d="M9 22 L23 22" />
        </g>
        <g fill="currentColor">
          <circle cx="16" cy="10" r="2.5" /><circle cx="9" cy="22" r="2.5" /><circle cx="23" cy="22" r="2.5" />
        </g>
      </svg>
      <span class="brand__text">
        <span class="brand__name">{profil.nom}</span>
        <span class="brand__sub">BTS SIO SISR</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
               aria-current={isActive(item.href) ? 'page' : undefined} data-en={item.en}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button id="lang-toggle" class="lang-btn" type="button" aria-label="Switch to English">EN</button>
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Changer de thème">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.5v2.4M12 19.1v2.4M21.5 12h-2.4M4.9 12H2.5M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7M18.4 18.4l-1.7-1.7M7.3 7.3L5.6 5.6"/>
          </g>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
      </button>
      <button id="menu-toggle" class="icon-btn menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><g stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></g></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Navigation" hidden>
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} class:list={['mobile-nav__link', { 'is-active': isActive(item.href) }]}
             aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: var(--line-w) solid var(--line);
  }
  .site-header__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .brand { display: inline-flex; align-items: center; gap: var(--sp-3); color: var(--ink); }
  .brand__mark { width: 28px; height: 28px; color: var(--accent); flex-shrink: 0; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand__name { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; }
  .brand__sub { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3); letter-spacing: 0.02em; }

  .site-nav__list { display: flex; align-items: center; gap: var(--sp-1); }
  .site-nav__link {
    display: inline-block;
    font-size: var(--t-sm);
    color: var(--ink-2);
    padding: 0.4rem 0.7rem;
    border-radius: var(--r-sm);
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .site-nav__link:hover { color: var(--ink); background: var(--surface-2); }
  .site-nav__link.is-active { color: var(--accent); }
  .site-nav__link.is-active:hover { background: var(--accent-wash); }

  .site-header__actions { display: flex; align-items: center; gap: var(--sp-2); }
  .lang-btn {
    height: 38px; padding: 0 0.7rem;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.04em;
    color: var(--ink-2);
    border: var(--line-w) solid var(--line); border-radius: var(--r-sm);
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .lang-btn:hover { color: var(--accent); border-color: var(--accent-line); background: var(--accent-wash); }
  .icon-btn {
    width: 38px; height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--ink-2);
    border: var(--line-w) solid var(--line);
    border-radius: var(--r-sm);
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .icon-btn:hover { color: var(--ink); border-color: var(--line-strong); background: var(--surface-2); }
  .icon-moon { display: none; }
  :root[data-theme='dark'] .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun { display: none; }
    :root:not([data-theme='light']) .icon-moon { display: block; }
  }

  .menu-toggle { display: none; }
  .mobile-nav { border-bottom: var(--line-w) solid var(--line); background: var(--surface); }
  .mobile-nav ul { display: flex; flex-direction: column; padding: var(--sp-2) clamp(1rem, 4vw, 2.25rem) var(--sp-4); }
  .mobile-nav__link {
    display: block; padding: 0.7rem 0.5rem; color: var(--ink-2);
    border-bottom: var(--line-w) solid var(--line);
    font-size: var(--t-md);
  }
  .mobile-nav__link:last-child { border-bottom: 0; }
  .mobile-nav__link.is-active { color: var(--accent); }

  @media (max-width: 880px) {
    .site-nav { display: none; }
    .menu-toggle { display: inline-flex; }
  }
</style>

<script>
  const mt = document.getElementById('menu-toggle');
  const mn = document.getElementById('mobile-nav');
  if (mt && mn) {
    mt.addEventListener('click', () => {
      const open = mn.hasAttribute('hidden');
      if (open) { mn.removeAttribute('hidden'); } else { mn.setAttribute('hidden', ''); }
      mt.setAttribute('aria-expanded', String(open));
      mt.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
  }
  const tt = document.getElementById('theme-toggle');
  if (tt) {
    tt.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme')
        || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  }
</script>

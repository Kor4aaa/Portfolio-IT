---
import Base from '@layouts/Base.astro';
import CoverageBar from '@components/CoverageBar.astro';
import RealisationCard from '@components/RealisationCard.astro';
import HeroDiagram from '@components/HeroDiagram.astro';
import { profil } from '@data/profil';
import { realisations } from '@data/realisations';
import { apercuReferentiel, compteursGlobaux } from '@data/derive';

const apercu = apercuReferentiel();
const totaux = compteursGlobaux();
const vedettes = realisations.filter((r) => r.vedette);

const [prenom, ...resteNom] = profil.nom.split(' ');
const nom = resteNom.join(' ');

const etapes = [
  { t: 'Référentiel', tEn: 'Framework', d: 'Les épreuves E5, E6 et E7 et leurs compétences officielles.', dEn: 'The E5, E6 and E7 units and their official skills.' },
  { t: 'Compétence', tEn: 'Skill', d: 'Chaque sous-compétence, avec son statut de maîtrise.', dEn: 'Each sub-skill, with its mastery status.' },
  { t: 'Réalisation', tEn: 'Project', d: 'Les projets et expériences qui mobilisent la compétence.', dEn: 'The projects and experiences that apply the skill.' },
  { t: 'Preuve', tEn: 'Evidence', d: 'Captures, schémas, configurations et documents à l\'appui.', dEn: 'Screenshots, diagrams, configs and supporting documents.' },
];
---
<Base path="/">
  <!-- ============== HERO ============== -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__intro">
        <p class="hero__eyebrow mono"><span class="hero__spark" aria-hidden="true"></span><span data-en="Evidence portfolio — BTS SIO SISR">Portfolio de preuves — BTS SIO SISR</span></p>
        <h1 class="hero__name"><span class="hero__fn">{prenom}</span><span class="hero__ln">{nom}</span></h1>
        <p class="hero__line">
          BTS SIO SISR <span class="hero__axes" data-en="— Systems, Networks &amp; Cybersecurity">— Systèmes, Réseaux &amp; Cybersécurité</span>
        </p>
        <p class="hero__pitch prose" data-en="Second-year BTS SIO SISR student, on a work-study placement as an IT support technician. I want to move to the other side of the ticket: design, deploy, secure and monitor infrastructure — and I'm getting ready by building a real segmented platform on Proxmox and pfSense.">{profil.pitch}</p>

        <blockquote class="hero__q" data-en="Which BTS SIO SISR framework skills can I demonstrate, through which projects, and with what evidence?">{profil.question}</blockquote>

        <div class="hero__cta">
          <a class="btn btn--primary" href="/referentiel" data-en="Explore the framework">Explorer le référentiel</a>
          <a class="btn btn--ghost" href="/realisations" data-en="See the projects">Voir les réalisations</a>
        </div>
      </div>

      <div class="hero__media">
        <HeroDiagram />
      </div>
    </div>
  </section>

  <!-- ============== COUVERTURE DU RÉFÉRENTIEL ============== -->
  <section class="section--tight cov-band">
    <div class="container">
      <div class="cov-band__head">
        <div>
          <span class="section-head__index" data-en="Framework status">État du référentiel</span>
          <h2 data-en="Skills coverage">Couverture des compétences</h2>
        </div>
        <span class="cov-band__count mono" data-en={`${totaux.sousTravaillees}/${totaux.sousTotal} sub-skills worked on`}>{totaux.sousTravaillees}/{totaux.sousTotal} sous-compétences travaillées</span>
      </div>
      <div class="cov-band__grid">
        {apercu.map((a) => (
          <a class="cov-card" href={`/referentiel#${a.epreuve.code.toLowerCase()}`}>
            <div class="cov-card__top">
              <span class="cov-card__code">{a.epreuve.code}</span>
              <span class="cov-card__pct mono">{a.taux}<span class="cov-card__pct-u">%</span></span>
            </div>
            <span class="cov-card__name">{a.epreuve.titre}</span>
            <div class="cov-card__bar"><CoverageBar dist={a.dist} total={a.total} showLegend={true} /></div>
            <span class="cov-card__foot mono" data-en={`${a.nbRealisations} project${a.nbRealisations > 1 ? 's' : ''} · ${a.total} sub-skills`}>{a.nbRealisations} réalisation{a.nbRealisations > 1 ? 's' : ''} · {a.total} sous-compétences</span>
          </a>
        ))}
      </div>
      <a class="cov-band__more link" href="/synthese" data-en="Detailed summary table">Tableau de synthèse détaillé</a>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============== CONCEPT (séquence réelle → numérotation légitime) ============== -->
  <section class="section concept">
    <div class="container">
      <div class="section-head">
        <span class="section-head__index" data-en="How to read this portfolio">Comment lire ce portfolio</span>
        <h2 data-en="From framework to evidence">Du référentiel à la preuve</h2>
        <p data-en="Every skill shown links to the projects that apply it and the evidence that backs it. Nothing is ticked without an associated project and proof.">Chaque compétence affichée renvoie aux réalisations qui la mobilisent et aux preuves qui la justifient. Rien n'est coché sans réalisation ni preuve associée.</p>
      </div>
      <ol class="steps">
        {etapes.map((e, i) => (
          <li class="step">
            <span class="step__num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="step__arrow" aria-hidden="true"></span>
            <span class="step__body">
              <span class="step__t" data-en={e.tEn}>{e.t}</span>
              <span class="step__d" data-en={e.dEn}>{e.d}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============== RÉALISATIONS VEDETTES ============== -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="section-head__index" data-en="Key projects">Réalisations principales</span>
          <h2 data-en="Projects at the core of the portfolio">Projets au cœur du portfolio</h2>
        </div>
        <a class="link" href="/realisations" data-en="All projects">Toutes les réalisations</a>
      </div>
      <div class="feat-grid">
        {vedettes.map((r) => <RealisationCard r={r} />)}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============== PARCOURS TEASER ============== -->
  <section class="section">
    <div class="container teaser">
      <div class="teaser__text">
        <span class="section-head__index" data-en="In short">En bref</span>
        <h2 data-en="Training, work-study and a personal lab">Formation, alternance et laboratoire personnel</h2>
        <p class="prose" data-en={`${profil.alternance.poste} at ${profil.alternance.entreprise} (client ${profil.alternance.client}) since September 2025, alongside the BTS SIO SISR. Professional experience and the Home Lab directly feed the framework skills.`}>
          {profil.alternance.poste} chez {profil.alternance.entreprise} (client {profil.alternance.client})
          depuis {profil.alternance.depuis.toLowerCase()}, en parallèle du BTS SIO SISR.
          Les expériences professionnelles et le Home Lab alimentent directement les compétences du référentiel.
        </p>
        <div class="teaser__cta">
          <a class="btn btn--ghost" href="/parcours" data-en="My background">Mon parcours</a>
          <a class="btn btn--ghost" href="/preuves" data-en="My evidence">Mes preuves</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; padding-block: clamp(2.75rem, 6vw, 5rem); overflow: hidden; }
  .hero__bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(130% 90% at 72% 18%, #000 25%, transparent 72%);
    mask-image: radial-gradient(130% 90% at 72% 18%, #000 25%, transparent 72%);
    opacity: 0.8;
  }
  :root[data-theme='dark'] .hero__bg::after {
    content: ''; position: absolute; top: -10%; right: -5%; width: 60%; height: 80%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 14%, transparent), transparent);
    filter: blur(10px);
  }
  .hero__grid {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--accent); font-size: var(--t-sm); margin-bottom: var(--sp-5); }
  .hero__spark { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent); }
  .hero__name {
    font-size: clamp(3.2rem, 1.6rem + 6.4vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .hero__name .hero__fn { display: block; }
  .hero__name .hero__ln { display: block; color: var(--ink-3); }
  .hero__line { font-family: var(--font-display); font-size: var(--t-md); color: var(--ink); margin-top: var(--sp-4); }
  .hero__axes { color: var(--ink-3); }
  .hero__pitch { color: var(--ink-2); margin-top: var(--sp-4); font-size: var(--t-md); line-height: 1.6; max-width: 48ch; }
  .hero__q {
    margin-top: var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: var(--line-w) solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--r-sm);
    font-family: var(--font-display);
    font-size: var(--t-md);
    color: var(--ink);
    line-height: 1.4;
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }

  /* Révélation orchestrée du hero (texte) */
  .hero__intro > * { opacity: 0; transform: translateY(10px); animation: heroIn 0.6s var(--ease) forwards; }
  .hero__intro > :nth-child(1) { animation-delay: 0.02s; }
  .hero__intro > :nth-child(2) { animation-delay: 0.10s; }
  .hero__intro > :nth-child(3) { animation-delay: 0.18s; }
  .hero__intro > :nth-child(4) { animation-delay: 0.26s; }
  .hero__intro > :nth-child(5) { animation-delay: 0.34s; }
  .hero__intro > :nth-child(6) { animation-delay: 0.42s; }
  @keyframes heroIn { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .hero__intro > * { opacity: 1; transform: none; animation: none; }
  }

  /* BANDE COUVERTURE */
  .cov-band__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--sp-4); margin-bottom: var(--sp-5); flex-wrap: wrap; }
  .cov-band__head h2 { font-size: var(--t-xl); margin-top: var(--sp-2); }
  .cov-band__count { font-size: var(--t-xs); color: var(--ink-3); }
  .cov-band__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .cov-card {
    display: flex; flex-direction: column; gap: var(--sp-3);
    padding: var(--sp-5);
    border: var(--line-w) solid var(--line);
    border-top: 2px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--surface);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .cov-card:hover { border-top-color: var(--accent); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .cov-card:hover { transform: translateY(-2px); } }
  .cov-card__top { display: flex; align-items: baseline; justify-content: space-between; }
  .cov-card__code { font-family: var(--font-display); font-weight: 700; font-size: var(--t-lg); color: var(--accent); }
  .cov-card__pct { font-size: var(--t-xl); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cov-card__pct-u { font-size: var(--t-sm); color: var(--ink-3); }
  .cov-card__name { font-size: var(--t-sm); color: var(--ink); line-height: 1.35; min-height: 2.6em; }
  .cov-card__foot { font-size: var(--t-xs); color: var(--ink-3); margin-top: auto; }
  .cov-band__more { display: inline-block; font-size: var(--t-sm); margin-top: var(--sp-5); }

  /* CONCEPT STEPS */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: var(--line-w) solid var(--line); border-radius: var(--r-md); overflow: hidden; }
  .step { display: flex; align-items: flex-start; gap: var(--sp-3); padding: var(--sp-5); position: relative; }
  .step + .step { border-left: var(--line-w) solid var(--line); }
  .step__num { color: var(--accent); font-size: var(--t-sm); font-weight: 600; }
  .step__arrow { display: none; }
  .step__body { display: flex; flex-direction: column; gap: 0.25rem; }
  .step__t { font-family: var(--font-display); font-weight: 600; }
  .step__d { font-size: var(--t-xs); color: var(--ink-2); line-height: 1.5; }

  /* FEATURED */
  .section-head--row { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--sp-4); }
  .section-head--row h2 { font-size: var(--t-xl); margin-top: var(--sp-2); }
  .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--sp-4); }

  /* TEASER */
  .teaser__text h2 { font-size: var(--t-xl); margin-top: var(--sp-2); margin-bottom: var(--sp-3); }
  .teaser__text p { color: var(--ink-2); }
  .teaser__cta { display: flex; gap: var(--sp-3); margin-top: var(--sp-5); flex-wrap: wrap; }

  @media (max-width: 980px) {
    .cov-band__grid { grid-template-columns: 1fr; }
    .cov-card__name { min-height: 0; }
  }
  @media (max-width: 920px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { max-width: 560px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .step:nth-child(3) { border-left: 0; }
    .step:nth-child(odd) { border-left: 0; }
    .step:nth-child(even) { border-left: var(--line-w) solid var(--line); }
    .step:nth-child(3), .step:nth-child(4) { border-top: var(--line-w) solid var(--line); }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .step { border-left: 0 !important; }
    .step + .step { border-top: var(--line-w) solid var(--line); }
    .section-head--row { flex-direction: column; align-items: flex-start; gap: var(--sp-2); }
  }
</style>

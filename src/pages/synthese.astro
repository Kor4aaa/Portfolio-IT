---
import Base from '@layouts/Base.astro';

// Document officiel fourni par Wensel Reyes, publié tel quel (aucune retouche).
const fichier = '/documents/Tableau-Synthese-E5-Wensel-Reyes.xlsx';
---
<Base
  title="Tableau de synthèse E5"
  description="Tableau de synthèse des réalisations professionnelles E5 (BTS SIO SISR, session 2026) de Wensel Reyes — document officiel à télécharger."
  path="/synthese"
>
  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <span class="section-head__index" data-en="Official E5 document">Document officiel E5</span>
        <h1 data-en="Summary table">Tableau de synthèse</h1>
        <p class="prose" data-en="The summary table of professional projects for unit E5 (session 2026), as submitted to the examination board. The original file is provided as is.">
          Le tableau de synthèse des réalisations professionnelles de l'épreuve E5 (session 2026),
          tel que remis au jury. Le fichier original est fourni tel quel.
        </p>
      </div>

      <div class="doc">
        <div class="doc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M9 13l6 6 M15 13l-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg>
        </div>
        <div class="doc__body">
          <p class="doc__name">Tableau-Synthese-E5-Wensel-Reyes.xlsx</p>
          <p class="doc__meta mono" data-en="Excel workbook · BTS SIO SISR · session 2026">Classeur Excel · BTS SIO SISR · session 2026</p>
        </div>
        <a class="btn btn--primary doc__btn" href={fichier} download>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span data-en="Download / print">Télécharger / imprimer</span>
        </a>
      </div>

      <p class="note" data-en={'E6 and E7 coverage is tracked on the <a class="link" href="/referentiel">Framework</a> page.'}>
        La couverture des épreuves E6 et E7 est suivie sur la page <a class="link" href="/referentiel">Référentiel</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .doc {
    display: flex; align-items: center; gap: var(--sp-4);
    padding: var(--sp-5);
    border: var(--line-w) solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--r-sm);
    background: var(--surface);
    max-width: 760px;
  }
  .doc__icon { color: var(--accent); flex-shrink: 0; }
  .doc__body { flex: 1; min-width: 0; }
  .doc__name { font-weight: 600; overflow-wrap: anywhere; }
  .doc__meta { font-size: var(--t-xs); color: var(--ink-3); margin-top: 0.2rem; }
  .doc__btn { flex-shrink: 0; }
  .note { margin-top: var(--sp-5); font-size: var(--t-sm); color: var(--ink-3); }

  @media (max-width: 600px) {
    .doc { flex-wrap: wrap; }
    .doc__btn { width: 100%; justify-content: center; }
  }
</style>
